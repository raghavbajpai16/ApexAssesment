# Database Configuration (MySQL 8)
# Option A: Unified Connection URL (Recommended for Cloud Providers: Render, Aiven, Railway, TiDB)
# DATABASE_URL=mysql://user:password@host:port/apex_tape_stock?ssl-mode=REQUIRED

# Option B: Individual Connection Parameters
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tape_user
DB_PASSWORD=tape_pass
DB_NAME=apex_tape_stock
DB_SSL=false

# Application / Session Secret
SESSION_SECRET=dev_secret_key_change_me_in_production_min_32_chars
